# ==============================================================================
# Bowl Storage Service — 线上生产环境预设配置 (prod)
# 数据库凭据通过宿主环境变量在 docker-compose.yaml 中组装注入 DB_DSN
# ==============================================================================

# --- 服务监听与传输限制 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
INTERNAL_SERVER_HOST=0.0.0.0
INTERNAL_SERVER_PORT=9090
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_STOP_TIMEOUT=30s
SERVER_READ_MAX_BYTES=16777216

# --- 控制面 PostgreSQL 连接池 ---
DB_MAX_CONNS=32
DB_MIN_CONNS=4
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=30s
DB_TRACING_ENABLED=true
DB_METRICS_ENABLED=true

# --- 存储引擎与 FUSE 内核缓存策略 ---
STORAGE_DATA_DIR=/var/lib/bowl/data
STORAGE_ATIME_MODE=noatime
STORAGE_ENTRY_TIMEOUT_SECONDS=1.0
STORAGE_ATTR_TIMEOUT_SECONDS=1.0
STORAGE_DIR_ENTRY_TIMEOUT_SECONDS=1.0
STORAGE_OPEN_KEEP_CACHE=false
STORAGE_OPEN_DIR_CACHE=false
STORAGE_GC_INTERVAL=30s

# --- 结构化日志（生产模式：JSON 结构化 + Info 控制面/引擎审计；高频读写成功路径已降为 Debug） ---
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false
LOG_CONNECT_MESSAGE=handled rpc

# --- 指标与性能剖析（仅在独立内网管理端口 :9090 暴露） ---
METRICS_ENABLED=true
PPROF_ENABLED=true
PPROF_MUTEX_FRACTION=5
PPROF_BLOCK_RATE=10000

# --- OpenTelemetry 链路追踪（经 Alloy OTLP 尾部采样：>10ms 慢请求与 ERROR Span 100% 保留后转发 Jaeger） ---
DEPLOY_ENV=production
OTEL_ENABLED=true
OTEL_SERVICE_NAME=bowl-storage
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=0.10
OTEL_TRUST_REMOTE=true
