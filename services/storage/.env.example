# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_STOP_TIMEOUT=10s
SERVER_READ_MAX_BYTES=131072

# Database Connection Pool Configuration
DB_DSN=postgres://postgres:postgres@localhost:5432/bowl?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_TRACING_ENABLED=true

# Storage Metadata & FUSE Cache Configuration
STORAGE_SESSION_LEASE_TTL=60s
STORAGE_ATIME_MODE=noatime
STORAGE_ENTRY_TIMEOUT_SECONDS=1.0
STORAGE_ATTR_TIMEOUT_SECONDS=1.0
STORAGE_DIR_ENTRY_TIMEOUT_SECONDS=1.0
STORAGE_OPEN_KEEP_CACHE=false
STORAGE_OPEN_DIR_CACHE=false

# OpenTelemetry Tracing Configuration
OTEL_ENABLED=false
OTEL_SERVICE_NAME=storage-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLE_RATIO=1.0
OTEL_TRUST_REMOTE=false

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONNECT_MESSAGE=handled rpc
