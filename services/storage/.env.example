# Database Configuration (Fail-fast if DB_DSN is missing)
DB_DSN=postgres://postgres:postgres@localhost:5432/bowl?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# HTTP/2 Server Configuration
HOST=0.0.0.0
PORT=8081
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=10s

# Storage Configuration
DATA_DIR=/tmp/bowl/data

# Upstream Disk Service Address
DISK_SERVICE_ADDR=http://127.0.0.1:8080
